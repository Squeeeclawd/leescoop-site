---
import type { CollectionEntry } from 'astro:content';
import { articlePath } from '@/lib/content';

interface Props {
  articles: CollectionEntry<'articles'>[];
}

const { articles } = Astro.props;
const items = [...articles, ...articles];
---
<section class="ticker" aria-label="Top headlines ticker">
  <div class="ticker-label">Top 5</div>
  <div class="ticker-track-wrap">
    <div class="ticker-track">
      {items.map((article, index) => (
        <a href={articlePath(article)} class="ticker-item" aria-hidden={index >= articles.length ? 'true' : 'false'}>
          <span class="ticker-rank">{((index % articles.length) + 1).toString().padStart(2, '0')}</span>
          <span>{article.data.title}</span>
        </a>
      ))}
    </div>
  </div>
</section>
