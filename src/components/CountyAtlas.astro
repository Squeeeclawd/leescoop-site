---
import { communities, columnShape, areaId } from '@/lib/areaAtlas';
interface Props { counts: Record<string, number>; }
const { counts } = Astro.props;
const max = Math.max(...Object.values(counts), 0);
---
<svg class="county-atlas" viewBox="0 0 700 485" aria-label="Schematic Lee County area map" role="group">
  <defs>
    <pattern id="atlas-grid" width="49" height="49" patternUnits="userSpaceOnUse"><path d="M49 0H0V49" fill="none" stroke="#487969" stroke-width=".8" opacity=".18"/></pattern>
    <pattern id="atlas-marsh" width="10" height="10" patternUnits="userSpaceOnUse"><path d="m1 9 3-3m3-4 1-1" stroke="#759882" stroke-width="1" opacity=".5"/></pattern>
    <pattern id="atlas-water" width="14" height="12" patternUnits="userSpaceOnUse"><path d="M1 8h3m5-5h2" stroke="#559992" stroke-width=".8" opacity=".35"/></pattern>
  </defs>
  <g aria-hidden="true" class="atlas-geography">
    <path fill="#c4ded4" d="M0 0H700V485H0Z"/>
    <path fill="url(#atlas-water)" d="M0 0H700V485H0Z"/>
    <g fill="none" stroke="#80b3a8" stroke-width="1.4" opacity=".75">
      <path d="M52-5C76 40 73 76 64 103S61 164 86 198 97 270 114 300s58 64 85 76 52 14 84 22 54 12 76 48l18 43"/>
      <path d="M36-5C60 42 60 77 49 103s-3 76 19 107 17 62 41 101 48 60 82 78 57 13 85 23 56 13 73 45l15 34"/>
      <path d="M21-5C45 42 45 77 34 103s-2 81 20 117 17 66 39 99 53 65 90 84 61 15 85 25 52 13 69 41l11 22"/>
    </g>
    <!-- Mainland shoreline, barrier islands, and the Caloosahatchee estuary. -->
    <g fill="#e4e7ca" stroke="#709786" stroke-width="1.8" stroke-linejoin="round">
      <path d="M223-6H706V490H438l-7-32-8-21-1-15-13-15-6-20-13-16-8-22-12-12-8-15-12-6-5-13-12-7-4-14-9-3-8 4-13-8-12 4-8-7-11 3-14-2 8-12 7-20-3-11 6-15 1-20 5-15-1-12 6-17-4-17-11-10-2-16-12-9-6-11-13-8-4-16-13-7-4-13-15-5-5-10 4-12-2-15-10-12 2-14Z"/>
      <path d="m171 132 6 4 3 18 7 10-1 12 9 13 7 1 1 8 11 16 6 3 9 20 3 13-10-5-10-12-6-3-8-12-8-7-2-10-11-15-3-17-7-14-1-12Z"/>
      <path d="m82 14 6 14-2 15 5 13-1 9 6 12-6 14-4-7-3-17-4-8 1-14-4-20Z"/>
      <path d="m94 112 9 16 9 19 2 15 11 20 6 17-5 4-13-27-6-21-11-20Z"/>
      <path d="m128 216 5 14 1 14 8 15-1 10-5-4-6-19-6-21Z"/>
      <path d="m138 274 5 10 2 13 9 13 2 9-7-2-8-14-6-18Z"/>
      <path d="m151 320 11-1 17 10 19 5 16 11 19 2 20-6 15-1-8 10-17 7-18 5-16-4-20-9-19-10-15-13Z"/>
      <path d="m321 326 7 4 8 14 10 9 7 13 12 11 4 9-11-5-12-16-10-7-7-15Z"/>
    </g>
    <path fill="#d1ddba" d="m245 5 44-5h64l-14 25-27 7-14 23-32 3-14-16Zm283 46 42-12 65 8 53 26-25 31-69-5-28 24-28-16-30-13Zm-29 226 35-19 27 14 40-14 42 30-6 41-50 1-24 29-38-3-13-32-20-5Z"/>
    <path fill="url(#atlas-marsh)" d="m245 5 44-5h64l-14 25-27 7-14 23-32 3-14-16Zm283 46 42-12 65 8 53 26-25 31-69-5-28 24-28-16-30-13Zm-29 226 35-19 27 14 40-14 42 30-6 41-50 1-24 29-38-3-13-32-20-5Z"/>
    <path fill="#c4ded4" stroke="#709786" stroke-width="1.3" d="m265 289 20-15 21-8 16-13 16-6 16-18 18-9 13-16 12-11 14-9 8-11 11-4 14-17 16-8 17-18 15-5 17-12 20-6 14-11 17 1 12-9 9 1 20-7 11 2-21 8-12 1-16 9-17 1-17 11-16 6-15 12-18 8-14 15-17 12-10 14-13 6-7 10-14 10-11 13-12 18-16 10-16 18-19 6-15 13-21 6-20 10Z"/>
    <path fill="url(#atlas-grid)" d="M0 0H700V485H0Z"/>
    <g class="atlas-water-label" fill="#527d78" font-family="Georgia, serif" font-style="italic">
      <text x="42" y="410" font-size="21" transform="rotate(-12 42 410)">Gulf coast</text>
      <text x="481" y="133" font-size="12" transform="rotate(-32 481 133)">Caloosahatchee River</text>
    </g>
    <g transform="translate(651 30)" stroke="#496558" fill="none"><path d="M0 31V8m0 0-5 11 5-4 5 4Z"/><text stroke="none" fill="#496558" text-anchor="middle" font-size="12" font-weight="700">N</text></g>
  </g>
  {communities.map(({name,x,y,dx,dy}) => {
    const count = counts[name] || 0, shape = columnShape(count,max);
    return <g transform={`translate(${x} ${y})`}><a class="atlas-marker" href={'#area-'+areaId(name)} data-area={name} aria-label={name + ': ' + count + (count===1?' event':' events')}>
      <circle class="atlas-hit" r="19" fill="transparent"/>
      <circle class="atlas-ring" r="13" fill="none" stroke-width="2.5"/>
      <circle class="atlas-dot" r={count ? 6.5 : 4} stroke="#fffbea" stroke-width="2"/>
      <g class="atlas-column"><path class="atlas-shadow" d="M-8 -4l8 4 12 -1 -8 -4z" fill="#426e60" opacity=".22"/><path data-face="left" d={shape.left} fill="#286c63"/><path data-face="right" d={shape.right} fill="#144a47"/><path data-face="top" d={shape.top} fill="#8cb598"/></g>
      <text x={dx} y={dy} text-anchor={dx < -9 ? 'end' : dx > 8 ? 'start' : 'middle'}>{name}</text>
    </a></g>;
  })}
</svg>
