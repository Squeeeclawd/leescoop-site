---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ShareButton from '@/components/ShareButton.astro';
import { isPublished } from '@/lib/content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.filter(isPublished).map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const displayDate = article.data.contentKind === 'event' ? article.data.eventDate : article.data.date;
function formatDate(value?: Date) {
  if (!value) return 'Date TBA';
  return value.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
}

const shareUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://leescoop.com').toString();
---
<BaseLayout title={`${article.data.title} | LeeScoop`} description={article.data.excerpt}>
  <Header />
  <main class="wrap article-shell">
    <article class="article-body panel-glow local-post-body">
      {article.data.coverImage && <img class="cover-image article-cover" src={article.data.coverImage} alt={`${article.data.title} cover image`} loading="eager" decoding="async" />}
      <header class="article-header">
        <div class="article-kicker-row">
          <p class="eyebrow">{article.data.category}</p>
          <span class={`meta-pill tone-${article.data.sourceType}`}>{article.data.contentKind === 'news' ? 'local news' : 'event'}</span>
        </div>
        <h1>{article.data.title}</h1>
        <p class="lede">{article.data.excerpt}</p>
        <dl class="post-fact-grid">
          <div><dt>When</dt><dd>{formatDate(displayDate)}{article.data.eventTime ? ` · ${article.data.eventTime}` : ''}</dd></div>
          {(article.data.venue || article.data.location || article.data.city) && <div><dt>Where</dt><dd>{article.data.venue ?? article.data.location ?? article.data.city}{article.data.address ? ` · ${article.data.address}` : ''}</dd></div>}
          {article.data.audience && <div><dt>Who it’s for</dt><dd>{article.data.audience}</dd></div>}
          {article.data.cost && <div><dt>Cost</dt><dd>{article.data.cost}</dd></div>}
          {article.data.sourceUrl && <div><dt>Official source</dt><dd><a href={article.data.sourceUrl}>{article.data.sourceName ?? 'Official event page'}</a></dd></div>}
        </dl>
        <div class="article-meta">
          <span>Posted by {article.data.author}</span>
          <span>{article.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          {article.data.city && <span>{article.data.city}</span>}
        </div>
        <ShareButton title={article.data.title} url={shareUrl} />
      </header>
      <Content />
    </article>
  </main>
  <Footer />
</BaseLayout>
