---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { site } from '@/data/site';
import { slugifyLabel, visibleArticles } from '@/lib/content';

export async function getStaticPaths() {
  return site.categories.map((category) => ({ params: { slug: slugifyLabel(category) }, props: { category } }));
}

const { category } = Astro.props;
const articles = visibleArticles(await getCollection('articles')).filter((article) => article.data.category === category);
---
<BaseLayout title={`${category} | LeeScoop`}>
  <Header />
  <main class="wrap page-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Area archive</p>
        <h1>{category}</h1>
      </div>
    </div>
    {articles.length > 0 ? (
      <div class="card-grid three">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    ) : (
      <div class="panel-glow home-empty-state">No {category} updates have been published yet.</div>
    )}
  </main>
  <Footer />
</BaseLayout>
