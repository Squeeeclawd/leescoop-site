---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { visibleArticles } from '@/lib/content';

export async function getStaticPaths() {
  const articles = visibleArticles(await getCollection('articles'));
  const tags = new Map<string, string>();
  for (const article of articles) {
    for (const tag of article.data.tags) {
      tags.set(tag.toLowerCase().replaceAll(' ', '-'), tag);
    }
  }
  return [...tags.entries()].map(([slug, tag]) => ({ params: { slug }, props: { tag } }));
}

const { tag } = Astro.props;
const articles = visibleArticles(await getCollection('articles')).filter((article) => article.data.tags.includes(tag));
---
<BaseLayout title={`${tag} | LeeScoop`}>
  <Header />
  <main class="wrap page-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Tag archive</p>
        <h1>{tag}</h1>
      </div>
    </div>
    <div class="card-grid three">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </main>
  <Footer />
</BaseLayout>
