---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { LEE_COUNTY_TIME_ZONE, activeArticles, articlePath, eventArchiveCutoff, sortArticlesForFeed, tagCounts } from '@/lib/content';

const allArticles = await getCollection('articles');
const visible = activeArticles(allArticles);
const feed = sortArticlesForFeed(visible);

function selectLeadArticle(articles: typeof visible) {
  const featured = articles.find((article) => article.data.featured);
  if (featured) return featured;

  return articles[0];
}

const lead = selectLeadArticle(feed);
const cardFeed = lead ? feed.filter((article) => article.slug !== lead.slug) : feed;
const topTags = tagCounts(allArticles).slice(0, 10);

const categoryAccentMap: Record<string, string> = {
  'Cape Coral': '#07506F',
  'Fort Myers': '#197894',
  'Bonita Springs': '#4FA7BC',
  'Estero': '#8BD2DE',
  'Fort Myers Beach': '#D94B32',
  'Sanibel': '#F28B42',
  'Lehigh Acres': '#F7DE69',
  'North Fort Myers': '#063A52',
  'Pine Island / Matlacha': '#8BD2DE',
  'Boca Grande': '#197894',
  'Captiva': '#4FA7BC'
};

const categoryTextMap: Record<string, string> = {
  'Cape Coral': '#FFFFFF',
  'Fort Myers': '#FFFFFF',
  'Bonita Springs': '#063A52',
  'Estero': '#063A52',
  'Fort Myers Beach': '#FFFFFF',
  'Sanibel': '#063A52',
  'Lehigh Acres': '#063A52',
  'North Fort Myers': '#FFFFFF',
  'Pine Island / Matlacha': '#063A52',
  'Boca Grande': '#FFFFFF',
  'Captiva': '#063A52'
};

const categoryOrder = [
  'Cape Coral',
  'Fort Myers',
  'Bonita Springs',
  'Estero',
  'Fort Myers Beach',
  'Sanibel',
  'Lehigh Acres',
  'North Fort Myers',
  'Pine Island / Matlacha',
  'Boca Grande',
  'Captiva'
];

function areaFor(article: typeof visible[number]) {
  return article.data.city || article.data.category;
}

const categoryStats = categoryOrder.map((category) => ({
  category,
  count: cardFeed.filter((article) => areaFor(article) === category).length,
  accent: categoryAccentMap[category] ?? '#197894',
  textColor: categoryTextMap[category] ?? '#FFFFFF'
})).filter((item) => item.count > 0);

const contentKindStats = [
  { kind: 'event', label: 'Events', count: cardFeed.filter((article) => article.data.contentKind !== 'news').length },
  { kind: 'news', label: 'Local News', count: cardFeed.filter((article) => article.data.contentKind === 'news').length }
];

function formatDate(value?: Date) {
  if (!value) return 'Date TBA';
  return value.toLocaleDateString('en-US', { timeZone: LEE_COUNTY_TIME_ZONE, month: 'short', day: 'numeric' });
}

function formatLongDate(value?: Date) {
  if (!value) return 'Date TBA';
  return value.toLocaleDateString('en-US', { timeZone: LEE_COUNTY_TIME_ZONE, weekday: 'short', month: 'short', day: 'numeric' });
}

function formatRangeEndpoint(value: Date, includeYear = false) {
  return value.toLocaleDateString('en-US', {
    timeZone: LEE_COUNTY_TIME_ZONE,
    month: 'short',
    day: 'numeric',
    ...(includeYear ? { year: 'numeric' as const } : {})
  });
}

function formatEventRange(start?: Date, end?: Date) {
  if (!start) return 'Date TBA';
  if (!end || dateKey(start) === dateKey(end)) return formatLongDate(start);

  const startYear = start.toLocaleDateString('en-US', { timeZone: LEE_COUNTY_TIME_ZONE, year: 'numeric' });
  const endYear = end.toLocaleDateString('en-US', { timeZone: LEE_COUNTY_TIME_ZONE, year: 'numeric' });
  const includeStartYear = startYear !== endYear;
  return `${formatRangeEndpoint(start, includeStartYear)}–${formatRangeEndpoint(end, true)}`;
}

function dateKey(value?: Date) {
  if (!value) return '';
  return new Intl.DateTimeFormat('en-CA', { timeZone: LEE_COUNTY_TIME_ZONE, year: 'numeric', month: '2-digit', day: '2-digit' }).format(value);
}

function eventEndDateKey(article: typeof visible[number]) {
  if (article.data.contentKind !== 'event') return '';
  return dateKey(eventArchiveCutoff(article) ?? article.data.eventDate);
}

const dateWindowStats = [
  { window: 'today', label: 'Today', help: 'Lee County time' },
  { window: 'weekend', label: 'This weekend', help: 'Sat + Sun' },
  { window: 'next14', label: 'Next 14 days', help: 'Today + 13 days' }
];

function hasMultiDayEventRange(article: typeof visible[number]) {
  if (article.data.contentKind !== 'event' || !article.data.eventDate) return false;
  const end = eventArchiveCutoff(article);
  return Boolean(end && dateKey(article.data.eventDate) !== dateKey(end));
}

function timelineDateLabel(article: typeof visible[number]) {
  if (article.data.contentKind === 'news') return 'Posted';
  return hasMultiDayEventRange(article) ? 'Runs' : 'Happens';
}

function timelineDateText(article: typeof visible[number]) {
  if (article.data.contentKind === 'news') return formatLongDate(article.data.date);
  if (!hasMultiDayEventRange(article)) return formatLongDate(article.data.eventDate);
  return formatEventRange(article.data.eventDate, eventArchiveCutoff(article));
}

function badgeParts(article: typeof visible[number]) {
  const start = displayDate(article);
  if (article.data.contentKind !== 'event' || !hasMultiDayEventRange(article)) {
    const parts = formatDate(start).split(' ');
    return { top: parts[0] ?? '', bottom: parts[1] ?? '' };
  }

  const end = eventArchiveCutoff(article);
  const startMonth = start?.toLocaleDateString('en-US', { timeZone: LEE_COUNTY_TIME_ZONE, month: 'short' }) ?? '';
  const endMonth = end?.toLocaleDateString('en-US', { timeZone: LEE_COUNTY_TIME_ZONE, month: 'short' }) ?? '';
  const startDay = start?.toLocaleDateString('en-US', { timeZone: LEE_COUNTY_TIME_ZONE, day: 'numeric' }) ?? '';
  const endDay = end?.toLocaleDateString('en-US', { timeZone: LEE_COUNTY_TIME_ZONE, day: 'numeric' }) ?? '';
  return {
    top: startMonth === endMonth ? startMonth : `${startMonth}–${endMonth}`,
    bottom: `${startDay}–${endDay}`
  };
}

function displayDate(article: typeof visible[number]) {
  return article.data.contentKind === 'event' ? article.data.eventDate : article.data.date;
}

function categoryAccent(category: string) {
  return categoryAccentMap[category] ?? '#197894';
}

function tileSearch(article: typeof visible[number]) {
  return [
    article.data.title,
    areaFor(article),
    article.data.category,
    article.data.city ?? '',
    article.data.location ?? '',
    article.data.venue ?? '',
    article.data.excerpt,
    article.data.contentKind ?? '',
    article.data.sourceName ?? '',
    ...article.data.tags
  ].join(' ').toLowerCase();
}
---
<BaseLayout
  title="LeeScoop"
  description="Your scoop on Lee County. No ads. No promotion. Just what’s happening in your area."
  image="/branding/leescoop-social-art.png"
  imageWidth={1254}
  imageHeight={1254}
>
  <Header enableSearchShortcut={true} searchTargetId="home-filter-input" />
  <main class="homepage-main" data-homepage-root>
    {!lead && (
      <section class="wrap homepage-section hero-section-home hero-panel panel-glow">
        <div class="hero-home-copy hero-home-copy-patch">
          <p class="eyebrow">Lee County, quickly</p>
          <h1 class="lead-headline lead-headline-patch">Your scoop on Lee County.</h1>
          <p class="lede">No ads. No promotion. Just what’s happening in your area.</p>
        </div>
      </section>
    )}

    {lead && (
      <section class="wrap homepage-section hero-section-home hero-panel panel-glow" data-expirable-feature data-kind={lead.data.contentKind} data-active-until={lead.data.contentKind === 'event' ? eventArchiveCutoff(lead)?.toISOString() : undefined}>
        <div class="hero-home-grid hero-home-grid-patch">
          <div class="hero-home-copy hero-home-copy-patch">
            <div class="hero-label-row">
              <div class="event-date-badge hero-date-badge">
                <span>{badgeParts(lead).top}</span>
                <strong>{badgeParts(lead).bottom}</strong>
              </div>
              <p class="eyebrow">{lead.data.contentKind === 'news' ? 'Featured update' : 'Featured event'}</p>
            </div>
            <h1 class="lead-headline lead-headline-patch" title={lead.data.title}>
              <a href={articlePath(lead)}>{lead.data.title}</a>
            </h1>
            <div class="hero-fact-grid" aria-label="Featured item details">
              <span class={`timeline-kind-pill ${lead.data.contentKind === 'news' ? 'is-news' : 'is-event'}`}>{lead.data.contentKind === 'news' ? 'News' : 'Event'}</span>
              <div class="hero-fact">
                <span>{timelineDateLabel(lead)}</span>
                <time datetime={displayDate(lead)?.toISOString()}>{timelineDateText(lead)}</time>
              </div>
              {lead.data.eventTime && (
                <div class="hero-fact">
                  <span>Time</span>
                  <strong>{lead.data.eventTime}</strong>
                </div>
              )}
              {(lead.data.venue || lead.data.location || lead.data.city) && (
                <div class="hero-fact">
                  <span>Place</span>
                  <strong>{lead.data.venue ?? lead.data.location ?? lead.data.city}</strong>
                </div>
              )}
              <button
                type="button"
                class="category-pill hero-category-pill"
                style={`--category-accent: ${categoryAccent(lead.data.category)}`}
                data-filter-category={areaFor(lead)}
              >
                {areaFor(lead)}
              </button>
            </div>
            <p class="lede small-note">{lead.data.excerpt}</p>
            <div class="homepage-cta-row">
              <a class="button primary homepage-cta" href={articlePath(lead)}>{lead.data.contentKind === 'news' ? 'Read update' : 'Event details'}</a>
              <a class="button secondary homepage-secondary-cta" href="#latest-feed">Browse latest</a>
            </div>
          </div>
          {lead.data.coverImage && (
            <a class="hero-home-image-wrap" href={articlePath(lead)} aria-label={lead.data.title}>
              <img class="hero-home-image" src={lead.data.coverImage} alt={`${lead.data.title} cover image`} loading="eager" decoding="async" />
            </a>
          )}
        </div>
      </section>
    )}

    <section class="wrap homepage-section filter-tile browse-panel panel-glow" id="browse" aria-label="Browse LeeScoop feed" data-filter-tile>
      <h2 class="sr-only">Browse LeeScoop feed</h2>

      <div class="browse-filter-main">
        <div class="content-kind-filter-row" aria-label="Primary feed categories">
          {contentKindStats.map((item) => (
            <button type="button" class="content-kind-filter" data-filter-kind={item.kind} aria-pressed="false" disabled={item.count === 0}>
              <span class="content-kind-icon" aria-hidden="true">
                {item.kind === 'event' ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 3v4M17 3v4M4.5 9.5h15" />
                    <path d="M6.5 5h11A2.5 2.5 0 0 1 20 7.5v10A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5v-10A2.5 2.5 0 0 1 6.5 5Z" />
                    <path d="m9 15 1.8 1.8L15.5 12" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 5.5h10.5A2.5 2.5 0 0 1 18 8v10.5H7.5A2.5 2.5 0 0 1 5 16V5.5Z" />
                    <path d="M18 8h1a2 2 0 0 1 2 2v6a2.5 2.5 0 0 1-2.5 2.5H18" />
                    <path d="M8 9h6M8 12h6M8 15h4" />
                  </svg>
                )}
              </span>
              <span class="content-kind-copy">
                <span>{item.label}</span>
                <small>{item.kind === 'event' ? 'Happening soon' : 'Latest updates'}</small>
              </span>
              <strong data-count-kind={item.kind}>{item.count}</strong>
            </button>
          ))}
        </div>

        <form class="filter-search-form" id="filter-search-form" action="/search/" method="get">
          <label class="sr-only" for="home-filter-input">Search the latest feed</label>
          <div class="filter-search-shell">
            <span class="filter-search-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
            </span>
            <input id="home-filter-input" name="q" type="search" autocomplete="off" placeholder="Search events, news, cities, or venues" />
          </div>
        </form>
      </div>

      <div class="date-window-filter-row" role="group" aria-label="Event date filters (America/New_York)">
        {dateWindowStats.map((item) => (
          <button type="button" class="date-window-filter" data-filter-date-window={item.window} aria-pressed="false">
            <span>{item.label}</span>
            <small>{item.help}</small>
            <strong data-count-date-window={item.window}>0</strong>
          </button>
        ))}
      </div>

      <div class="filter-area-strip" aria-label="Area filters">
        <div class="filter-tile-pill-row" aria-label="Areas">
          {categoryStats.map((item) => (
            <button
              type="button"
              class="filter-tile-pill"
              data-filter-category={item.category}
              data-filter-pill={item.category}
              aria-pressed="false"
              style={`--pill-fill: ${item.accent}; --pill-text: ${item.textColor};`}
            >
              <span>{item.category}</span>
              <span data-count-for={item.category}>{item.count}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="filter-tile-footer">
        <button type="button" class="filter-clear-all" id="filter-clear-all" hidden>clear all filters ×</button>
      </div>
    </section>

    <section class="wrap homepage-section tile-section" id="latest-feed" aria-label="Upcoming events and local updates">
      <div class="section-heading feed-heading">
        <div>
          <p class="eyebrow">Latest</p>
          <h2>Latest around Lee County</h2>
          <p class="section-deck">News and events in one dated feed, sorted by when they matter.</p>
        </div>
      </div>
      <div class="home-tile-grid" id="home-tile-grid">
        {cardFeed.map((article) => {
          const hasCover = Boolean(article.data.coverImage);
          const cardDate = displayDate(article);
          const cardDateParts = badgeParts(article);
          return (
            <article class={`home-tile ${hasCover ? 'has-cover' : 'no-cover'}`} data-category={areaFor(article)} data-kind={article.data.contentKind === 'news' ? 'news' : 'event'} data-display-date={cardDate?.toISOString() ?? ''} data-date-key={dateKey(cardDate)} data-end-date-key={eventEndDateKey(article)} data-active-until={article.data.contentKind === 'event' ? eventArchiveCutoff(article)?.toISOString() ?? '' : ''} data-search={tileSearch(article)}>
              <a class="home-tile-stretch" href={articlePath(article)} aria-label={article.data.title}></a>

              {hasCover && (
                <div class="home-tile-media">
                  <img class="home-tile-image" src={article.data.coverImage!} alt={`${article.data.title} cover image`} loading="lazy" decoding="async" />
                  <button type="button" class="tile-category-pill" data-filter-category={areaFor(article)}>{areaFor(article)}</button>
                </div>
              )}

              <div class="home-tile-body">
                <div class="tile-top-row">
                  <div class="event-date-badge">
                    <span>{cardDateParts.top}</span>
                    <strong>{cardDateParts.bottom}</strong>
                  </div>
                  <div class="tile-label-stack">
                    <span class={`timeline-kind-pill ${article.data.contentKind === 'news' ? 'is-news' : 'is-event'}`}>{article.data.contentKind === 'news' ? 'News' : 'Event'}</span>
                    <button type="button" class="tile-category-pill tile-category-pill-static" data-filter-category={areaFor(article)}>{areaFor(article)}</button>
                  </div>
                </div>
                <h2 class="home-tile-title" title={article.data.title}>{article.data.title}</h2>
                <p class="home-tile-deck">{article.data.excerpt}</p>
                <div class="tile-meta-row">
                  <time datetime={cardDate?.toISOString()}>{timelineDateLabel(article)} {timelineDateText(article)}</time>
                  {article.data.eventTime && <span>{article.data.eventTime}</span>}
                  {(article.data.venue || article.data.location || article.data.city) && <span>{article.data.venue ?? article.data.location ?? article.data.city}</span>}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div class="home-empty-state" id="home-empty-state" role="status" hidden>No updates match that filter right now.</div>
    </section>
  </main>
  <Footer tags={topTags} />

  <script is:inline>
    (() => {
      const tiles = Array.from(document.querySelectorAll('.home-tile'));
      const filterPills = Array.from(document.querySelectorAll('[data-filter-pill]'));
      const kindButtons = Array.from(document.querySelectorAll('[data-filter-kind]'));
      const tileButtons = Array.from(document.querySelectorAll('.tile-category-pill, .hero-category-pill'));
      const searchInput = document.getElementById('home-filter-input');
      const searchForm = document.getElementById('filter-search-form');
      const clearAll = document.getElementById('filter-clear-all');
      const emptyState = document.getElementById('home-empty-state');
      const dateButtons = Array.from(document.querySelectorAll('[data-filter-date-window]'));
      const feature = document.querySelector('[data-expirable-feature]');
      const state = { category: '', kind: '', dateWindow: '', query: '' };

      const leeCountyDateKey = (value) => new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).format(value);
      const addDays = (date, days) => {
        // Add Lee County civil days independently of the visitor's timezone/DST.
        const copy = new Date(`${leeCountyDateKey(date)}T12:00:00Z`);
        copy.setUTCDate(copy.getUTCDate() + days);
        return copy;
      };
      let filterNow = new Date();
      const dateWindowRange = (dateWindow) => {
        const now = filterNow;
        if (dateWindow === 'today') {
          const key = leeCountyDateKey(now);
          return { start: key, end: key };
        }
        if (dateWindow === 'next14') {
          return { start: leeCountyDateKey(now), end: leeCountyDateKey(addDays(now, 13)) };
        }
        if (dateWindow !== 'weekend') return undefined;

        const weekdayMap = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
        const weekday = weekdayMap[now.toLocaleDateString('en-US', { timeZone: 'America/New_York', weekday: 'short' })] ?? now.getDay();
        const daysUntilSaturday = weekday === 0 ? -1 : (6 - weekday);
        const saturday = addDays(now, daysUntilSaturday);
        return { start: leeCountyDateKey(saturday), end: leeCountyDateKey(addDays(saturday, 1)) };
      };
      const isPastActiveWindow = (tile) => {
        if (tile.getAttribute('data-kind') !== 'event') return false;
        const activeUntil = tile.getAttribute('data-active-until');
        return activeUntil && new Date(activeUntil).getTime() < filterNow.getTime();
      };
      const matchesDateWindow = (tile, dateWindow = state.dateWindow) => {
        if (!dateWindow) return true;
        if (tile.getAttribute('data-kind') !== 'event') return false;
        const startKey = tile.getAttribute('data-date-key') || '';
        const endKey = tile.getAttribute('data-end-date-key') || startKey;
        const range = dateWindowRange(dateWindow);
        if (!startKey || !endKey || !range) return false;
        return startKey <= range.end && endKey >= range.start;
      };

      if (feature instanceof HTMLElement && isPastActiveWindow(feature)) feature.hidden = true;

      if (!(searchInput instanceof HTMLInputElement) || !(searchForm instanceof HTMLFormElement) || !(clearAll instanceof HTMLButtonElement) || !(emptyState instanceof HTMLElement)) return;

      const updateCounts = () => {
        const query = state.query.trim().toLowerCase();
        filterPills.forEach((pill) => {
          if (!(pill instanceof HTMLElement)) return;
          const category = pill.getAttribute('data-filter-category') || '';
          const countTarget = pill.querySelector('[data-count-for]');
          const count = tiles.filter((tile) => {
            const tileCategory = tile.getAttribute('data-category') || '';
            const tileKind = tile.getAttribute('data-kind') || '';
            const haystack = tile.getAttribute('data-search') || '';
            return !isPastActiveWindow(tile) && tileCategory === category && (!state.kind || tileKind === state.kind) && matchesDateWindow(tile) && (!query || haystack.includes(query));
          }).length;
          if (countTarget) countTarget.textContent = String(count);
          pill.hidden = count === 0 && state.category !== category;
          pill.setAttribute('aria-pressed', String(state.category === category));
          pill.classList.toggle('is-active', state.category === category);
        });

        kindButtons.forEach((button) => {
          if (!(button instanceof HTMLElement)) return;
          const kind = button.getAttribute('data-filter-kind') || '';
          const countTarget = button.querySelector('[data-count-kind]');
          const count = tiles.filter((tile) => {
            const tileCategory = tile.getAttribute('data-category') || '';
            const tileKind = tile.getAttribute('data-kind') || '';
            const haystack = tile.getAttribute('data-search') || '';
            return !isPastActiveWindow(tile) && tileKind === kind && (!state.category || tileCategory === state.category) && (kind === 'news' || matchesDateWindow(tile)) && (!query || haystack.includes(query));
          }).length;
          if (countTarget) countTarget.textContent = String(count);
          if (button instanceof HTMLButtonElement) button.disabled = count === 0 && state.kind !== kind;
          button.setAttribute('aria-pressed', String(state.kind === kind));
          button.classList.toggle('is-active', state.kind === kind);
        });
      };

      const updateDateCounts = () => {
        dateButtons.forEach((button) => {
          if (!(button instanceof HTMLElement)) return;
          const dateWindow = button.getAttribute('data-filter-date-window') || '';
          const countTarget = button.querySelector('[data-count-date-window]');
          const query = state.query.trim().toLowerCase();
          const count = tiles.filter((tile) => {
            const category = tile.getAttribute('data-category') || '';
            const haystack = tile.getAttribute('data-search') || '';
            return !isPastActiveWindow(tile) && matchesDateWindow(tile, dateWindow) && (!state.category || category === state.category) && (!query || haystack.includes(query));
          }).length;
          if (countTarget) countTarget.textContent = String(count);
          if (button instanceof HTMLButtonElement) button.disabled = count === 0 && state.dateWindow !== dateWindow;
          button.setAttribute('aria-pressed', String(state.dateWindow === dateWindow));
          button.classList.toggle('is-active', state.dateWindow === dateWindow);
        });
      };

      const applyFilters = () => {
        filterNow = new Date();
        if (feature instanceof HTMLElement) feature.hidden = Boolean(isPastActiveWindow(feature));
        const query = state.query.trim().toLowerCase();
        let visibleCount = 0;
        tiles.forEach((tile) => {
          const category = tile.getAttribute('data-category') || '';
          const kind = tile.getAttribute('data-kind') || '';
          const haystack = tile.getAttribute('data-search') || '';
          const matchesCategory = !state.category || category === state.category;
          const matchesKind = !state.kind || kind === state.kind;
          const matchesDate = matchesDateWindow(tile);
          const matchesQuery = !query || haystack.includes(query);
          const shouldShow = !isPastActiveWindow(tile) && matchesCategory && matchesKind && matchesDate && matchesQuery;
          tile.hidden = !shouldShow;
          if (shouldShow) visibleCount += 1;
        });
        updateCounts();
        updateDateCounts();
        clearAll.hidden = !(state.category || state.kind || state.dateWindow || state.query.trim());
        emptyState.hidden = visibleCount > 0;
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const filterButton = target.closest('[data-filter-category]');
        if (filterButton instanceof HTMLElement) {
          event.preventDefault();
          const category = filterButton.getAttribute('data-filter-category') || '';
          state.category = state.category === category ? '' : category;
          applyFilters();
          return;
        }
        const kindButton = target.closest('[data-filter-kind]');
        if (kindButton instanceof HTMLElement) {
          event.preventDefault();
          const kind = kindButton.getAttribute('data-filter-kind') || '';
          state.kind = state.kind === kind ? '' : kind;
          if (state.kind === 'news') state.dateWindow = '';
          applyFilters();
          return;
        }
        const dateButton = target.closest('[data-filter-date-window]');
        if (dateButton instanceof HTMLElement) {
          event.preventDefault();
          const dateWindow = dateButton.getAttribute('data-filter-date-window') || '';
          state.dateWindow = state.dateWindow === dateWindow ? '' : dateWindow;
          if (state.dateWindow) state.kind = 'event';
          applyFilters();
          return;
        }
        if (target.closest('#filter-clear-all') === clearAll) {
          state.category = '';
          state.kind = '';
          state.dateWindow = '';
          state.query = '';
          searchInput.value = '';
          applyFilters();
          searchInput.focus();
        }
      });

      searchInput.addEventListener('input', () => {
        state.query = searchInput.value;
        applyFilters();
      });

      searchForm.addEventListener('submit', () => {
        state.query = searchInput.value;
      });

      tileButtons.forEach((button) => {
        if (!(button instanceof HTMLElement)) return;
        button.addEventListener('click', () => {
          const filterTile = document.querySelector('[data-filter-tile]');
          if (filterTile) filterTile.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });

      applyFilters();
      // Keep date counts and expiry accurate for tabs left open across midnight.
      window.setInterval(applyFilters, 60_000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) applyFilters(); });
    })();
  </script>
</BaseLayout>
