---
import '@/styles/discovery.css';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { activeArticles, articlePath, eventArchiveCutoff, sortArticlesForFeed, tagCounts } from '@/lib/content';
import { homepageDateKey, homepageDisplayDate, homepageTimelineDateLabel, homepageTimelineDateText } from '@/lib/homepageDateLabels';

const allArticles = await getCollection('articles');
const visible = activeArticles(allArticles);
const feed = sortArticlesForFeed(visible);

const cardFeed = [...feed.filter(a => a.data.contentKind === 'event'), ...feed.filter(a => a.data.contentKind === 'news')];
const topTags = tagCounts(allArticles).slice(0, 10);

const categoryAccentMap: Record<string, string> = {
  'Cape Coral': '#07506F',
  'Fort Myers': '#197894',
  'Bonita Springs': '#4FA7BC',
  'Estero': '#8BD2DE',
  'Fort Myers Beach': '#D94B32',
  'Sanibel': '#F28B42',
  'Lehigh Acres': '#F7DE69',
  'North Fort Myers': '#063A52',
  'Pine Island / Matlacha': '#8BD2DE',
  'Boca Grande': '#197894',
  'Captiva': '#4FA7BC'
};

const categoryTextMap: Record<string, string> = {
  'Cape Coral': '#FFFFFF',
  'Fort Myers': '#FFFFFF',
  'Bonita Springs': '#063A52',
  'Estero': '#063A52',
  'Fort Myers Beach': '#FFFFFF',
  'Sanibel': '#063A52',
  'Lehigh Acres': '#063A52',
  'North Fort Myers': '#FFFFFF',
  'Pine Island / Matlacha': '#063A52',
  'Boca Grande': '#FFFFFF',
  'Captiva': '#063A52'
};

const categoryOrder = [
  'Cape Coral',
  'Fort Myers',
  'Bonita Springs',
  'Estero',
  'Fort Myers Beach',
  'Sanibel',
  'Lehigh Acres',
  'North Fort Myers',
  'Pine Island / Matlacha',
  'Boca Grande',
  'Captiva'
];

function areaFor(article: typeof visible[number]) {
  return article.data.city || article.data.category;
}

const categoryStats = categoryOrder.map((category) => ({
  category,
  count: cardFeed.filter((article) => areaFor(article) === category).length,
  accent: categoryAccentMap[category] ?? '#197894',
  textColor: categoryTextMap[category] ?? '#FFFFFF'
})).filter((item) => item.count > 0);

const contentKindStats = [
  { kind: 'event', label: 'Events', count: cardFeed.filter((article) => article.data.contentKind !== 'news').length },
  { kind: 'news', label: 'Local News', count: cardFeed.filter((article) => article.data.contentKind === 'news').length }
];

function eventEndDateKey(article: typeof visible[number]) {
  if (article.data.contentKind !== 'event') return '';
  return homepageDateKey(eventArchiveCutoff(article) ?? article.data.eventDate);
}

const dateWindowStats = [
  { window: 'today', label: 'Today', help: 'Lee County time' },
  { window: 'weekend', label: 'This weekend', help: 'Sat + Sun' },
  { window: 'next14', label: 'Next 14 days', help: 'Today + 13 days' }
];

function timelineDateLabel(article: typeof visible[number]) {
  return homepageTimelineDateLabel(article, eventArchiveCutoff(article));
}

function timelineDateText(article: typeof visible[number]) {
  return homepageTimelineDateText(article, eventArchiveCutoff(article));
}

function displayDate(article: typeof visible[number]) {
  return homepageDisplayDate(article);
}

function safeSourceUrl(value?: string) {
  if (!value) return undefined;
  try {
    const parsed = new URL(value);
    return parsed.protocol === 'https:' || parsed.protocol === 'http:' ? parsed.href : undefined;
  } catch { return undefined; }
}

function tileSearch(article: typeof visible[number]) {
  return [
    article.data.title,
    areaFor(article),
    article.data.category,
    article.data.city ?? '',
    article.data.location ?? '',
    article.data.venue ?? '',
    article.data.excerpt,
    article.data.contentKind ?? '',
    article.data.sourceName ?? '',
    ...article.data.tags
  ].join(' ').toLowerCase();
}
---

<BaseLayout title="LeeScoop — Find your next local adventure" description="Good times, close to home. Discover Lee County events and quick, source-linked local news." image="/branding/leescoop-social-art.png" imageWidth={1254} imageHeight={1254}>
  <div class="discovery-shell">
  <a class="discovery-skip" href="#latest-feed">Skip to events</a>
  <Header enableSearchShortcut={true} />
  <main class="homepage-main discovery" data-homepage-root>
    <h1 class="discovery-heading">Good times. <span>Close to home.</span></h1>
    <section class="discovery-filters" id="browse" aria-label="Browse LeeScoop feed" data-filter-tile>
      <div class="discovery-filter-top">
        <div class="discovery-tabs" role="group" aria-label="Feed type">
          {contentKindStats.map(item => <button type="button" data-filter-kind={item.kind} aria-pressed={item.kind === 'event' ? 'true' : 'false'}>{item.label} <span data-count-kind={item.kind}>{item.count}</span></button>)}
        </div>
        <button type="button" id="saved-filter" aria-pressed="false">Saved</button>
        <details class="discovery-more">
          <summary>Search &amp; area</summary>
          <div class="discovery-more-panel">
            <form id="filter-search-form" action="/search/" method="get">
              <label for="home-filter-input">Find a plan</label>
              <input id="home-filter-input" name="q" type="search" autocomplete="off" placeholder="Music, markets, venues…" />
            </form>
            <div class="discovery-areas" role="group" aria-label="Areas">
              {categoryStats.map(item => <button type="button" data-filter-category={item.category} data-filter-pill={item.category} aria-pressed="false">{item.category} <span data-count-for={item.category}>{item.count}</span></button>)}
            </div>
            <p>Dates are in Lee County time. Runs may have select performances; check the organizer.</p>
          </div>
        </details>
      </div>
      <div class="discovery-dates" role="group" aria-label="Event date filters (America/New_York)">
        {dateWindowStats.map(item => <button type="button" class="date-window-filter" data-filter-date-window={item.window} aria-pressed="false" title={item.help}>{item.label} <span data-count-date-window={item.window}>0</span></button>)}
        <button type="button" id="filter-clear-all" hidden>Reset</button>
      </div>
    </section>
    <section id="latest-feed" class="discovery-feed" aria-label="Upcoming events and local updates" tabindex="-1">
      <div class="discovery-feed-status"><p id="feed-result" role="status">Explore Lee County</p><span>Scroll for your next outing ↓</span></div>
      <p id="action-status" role="status" class="discovery-action-status"></p>
      <noscript>JavaScript is off: browse all listings below. Event details and calendar downloads still work.</noscript>
      <div class="home-tile-grid" id="home-tile-grid">
        {cardFeed.map((article, index) => {
          const cardDate = displayDate(article);
          const news = article.data.contentKind === 'news';
          const destination = news ? safeSourceUrl(article.data.sourceUrl) ?? articlePath(article) : articlePath(article);
          return <article class="home-tile discovery-card" data-slug={article.slug} data-category={areaFor(article)} data-kind={news ? 'news' : 'event'} data-display-date={cardDate?.toISOString() ?? ''} data-date-key={homepageDateKey(cardDate)} data-end-date-key={eventEndDateKey(article)} data-active-until={!news ? eventArchiveCutoff(article)?.toISOString() ?? '' : ''} data-search={tileSearch(article)}>
            {article.data.coverImage && <a class="discovery-image-link" href={destination} tabindex="-1" aria-hidden="true"><img src={article.data.coverImage} alt="" width="1216" height="704" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></a>}
            <div class="discovery-card-body">
              <div class="discovery-kicker"><span>{areaFor(article)}</span><span>{news ? 'Local news' : article.data.featured ? 'Scoop pick' : 'Go local'}</span></div>
              <p class="discovery-date"><time datetime={cardDate?.toISOString()}>{timelineDateLabel(article)} {timelineDateText(article)}</time></p>
              <h2><a href={destination}>{article.data.title}</a></h2>
              {!news && <p class="discovery-place">{article.data.venue ?? article.data.location ?? article.data.city}{article.data.eventTime && ` · ${article.data.eventTime}`}{article.data.cost && ` · ${article.data.cost}`}</p>}
              <p class="discovery-excerpt">{article.data.excerpt.length > 180 ? article.data.excerpt.slice(0, 177) + '…' : article.data.excerpt}</p>
              <div class="discovery-actions">
                <a class="discovery-primary" href={destination}>{news ? `Read at ${article.data.sourceName || 'source'} ↗` : 'Details ↗'}</a>
                <button type="button" data-save={article.slug} aria-pressed="false" aria-label={`Save ${article.data.title}`}>Save</button>
                <button type="button" data-share={articlePath(article)} data-title={article.data.title} aria-label={`Share ${article.data.title}`}>Share</button>
                {!news && article.data.eventDate && <a href={`/calendar/${article.slug}.ics`} download aria-label={`Download date reminder for ${article.data.title}`}>Calendar</a>}
              </div>
            </div>
          </article>;
        })}
      </div>
      <div class="home-empty-state" id="home-empty-state" role="status" hidden>No matches. Try another date, area, or reset your filters.</div>
      <p id="saved-empty" role="status" hidden>No saved items in this view. Save a few plans, or reset your filters.</p>
      <p class="discovery-footnote">Saved on this browser, no account needed. Calendar downloads are date reminders, not tickets; confirm times with the organizer.</p>
    </section>
  </main>
  <Footer tags={topTags} />
  </div>
  <script is:inline>
    (() => {
      const tiles = Array.from(document.querySelectorAll('.home-tile'));
      const filterPills = Array.from(document.querySelectorAll('[data-filter-pill]'));
      const kindButtons = Array.from(document.querySelectorAll('[data-filter-kind]'));
      const searchInput = document.getElementById('home-filter-input');
      const searchForm = document.getElementById('filter-search-form');
      const clearAll = document.getElementById('filter-clear-all');
      const emptyState = document.getElementById('home-empty-state');
      const dateButtons = Array.from(document.querySelectorAll('[data-filter-date-window]'));
      const feature = document.querySelector('[data-expirable-feature]');
      const state = { category: '', kind: 'event', dateWindow: '', query: '' };

      const leeCountyDateKey = (value) => new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).format(value);
      const addDays = (date, days) => {
        // Add Lee County civil days independently of the visitor's timezone/DST.
        const copy = new Date(`${leeCountyDateKey(date)}T12:00:00Z`);
        copy.setUTCDate(copy.getUTCDate() + days);
        return copy;
      };
      let filterNow = new Date();
      const dateWindowRange = (dateWindow) => {
        const now = filterNow;
        if (dateWindow === 'today') {
          const key = leeCountyDateKey(now);
          return { start: key, end: key };
        }
        if (dateWindow === 'next14') {
          return { start: leeCountyDateKey(now), end: leeCountyDateKey(addDays(now, 13)) };
        }
        if (dateWindow !== 'weekend') return undefined;

        const weekdayMap = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
        const weekday = weekdayMap[now.toLocaleDateString('en-US', { timeZone: 'America/New_York', weekday: 'short' })] ?? now.getDay();
        const daysUntilSaturday = weekday === 0 ? -1 : (6 - weekday);
        const saturday = addDays(now, daysUntilSaturday);
        return { start: leeCountyDateKey(saturday), end: leeCountyDateKey(addDays(saturday, 1)) };
      };
      const isPastActiveWindow = (tile) => {
        if (tile.getAttribute('data-kind') !== 'event') return false;
        const activeUntil = tile.getAttribute('data-active-until');
        return activeUntil && new Date(activeUntil).getTime() < filterNow.getTime();
      };
      const matchesDateWindow = (tile, dateWindow = state.dateWindow) => {
        if (!dateWindow) return true;
        if (tile.getAttribute('data-kind') !== 'event') return false;
        const startKey = tile.getAttribute('data-date-key') || '';
        const endKey = tile.getAttribute('data-end-date-key') || startKey;
        const range = dateWindowRange(dateWindow);
        if (!startKey || !endKey || !range) return false;
        return startKey <= range.end && endKey >= range.start;
      };

      if (feature instanceof HTMLElement && isPastActiveWindow(feature)) feature.hidden = true;

      if (!(searchInput instanceof HTMLInputElement) || !(searchForm instanceof HTMLFormElement) || !(clearAll instanceof HTMLButtonElement) || !(emptyState instanceof HTMLElement)) return;

      const updateCounts = () => {
        const query = state.query.trim().toLowerCase();
        filterPills.forEach((pill) => {
          if (!(pill instanceof HTMLElement)) return;
          const category = pill.getAttribute('data-filter-category') || '';
          const countTarget = pill.querySelector('[data-count-for]');
          const count = tiles.filter((tile) => {
            const tileCategory = tile.getAttribute('data-category') || '';
            const tileKind = tile.getAttribute('data-kind') || '';
            const haystack = tile.getAttribute('data-search') || '';
            return !isPastActiveWindow(tile) && tileCategory === category && (!state.kind || tileKind === state.kind) && matchesDateWindow(tile) && (!query || haystack.includes(query));
          }).length;
          if (countTarget) countTarget.textContent = String(count);
          pill.hidden = count === 0 && state.category !== category;
          pill.setAttribute('aria-pressed', String(state.category === category));
          pill.classList.toggle('is-active', state.category === category);
        });

        kindButtons.forEach((button) => {
          if (!(button instanceof HTMLElement)) return;
          const kind = button.getAttribute('data-filter-kind') || '';
          const countTarget = button.querySelector('[data-count-kind]');
          const count = tiles.filter((tile) => {
            const tileCategory = tile.getAttribute('data-category') || '';
            const tileKind = tile.getAttribute('data-kind') || '';
            const haystack = tile.getAttribute('data-search') || '';
            return !isPastActiveWindow(tile) && tileKind === kind && (!state.category || tileCategory === state.category) && (kind === 'news' || matchesDateWindow(tile)) && (!query || haystack.includes(query));
          }).length;
          if (countTarget) countTarget.textContent = String(count);
          if (button instanceof HTMLButtonElement) button.disabled = count === 0 && state.kind !== kind;
          button.setAttribute('aria-pressed', String(state.kind === kind));
          button.classList.toggle('is-active', state.kind === kind);
        });
      };

      const updateDateCounts = () => {
        dateButtons.forEach((button) => {
          if (!(button instanceof HTMLElement)) return;
          const dateWindow = button.getAttribute('data-filter-date-window') || '';
          const countTarget = button.querySelector('[data-count-date-window]');
          const query = state.query.trim().toLowerCase();
          const count = tiles.filter((tile) => {
            const category = tile.getAttribute('data-category') || '';
            const haystack = tile.getAttribute('data-search') || '';
            return !isPastActiveWindow(tile) && matchesDateWindow(tile, dateWindow) && (!state.category || category === state.category) && (!query || haystack.includes(query));
          }).length;
          if (countTarget) countTarget.textContent = String(count);
          if (button instanceof HTMLButtonElement) button.disabled = count === 0 && state.dateWindow !== dateWindow;
          button.setAttribute('aria-pressed', String(state.dateWindow === dateWindow));
          button.classList.toggle('is-active', state.dateWindow === dateWindow);
        });
      };

      const applyFilters = () => {
        filterNow = new Date();
        if (feature instanceof HTMLElement) feature.hidden = Boolean(isPastActiveWindow(feature));
        const query = state.query.trim().toLowerCase();
        let visibleCount = 0;
        tiles.forEach((tile) => {
          const category = tile.getAttribute('data-category') || '';
          const kind = tile.getAttribute('data-kind') || '';
          const haystack = tile.getAttribute('data-search') || '';
          const matchesCategory = !state.category || category === state.category;
          const matchesKind = !state.kind || kind === state.kind;
          const matchesDate = matchesDateWindow(tile);
          const matchesQuery = !query || haystack.includes(query);
          const shouldShow = !isPastActiveWindow(tile) && matchesCategory && matchesKind && matchesDate && matchesQuery;
          tile.hidden = !shouldShow;
          if (shouldShow) visibleCount += 1;
        });
        const result = document.getElementById('feed-result');
        if (result) result.textContent = `${visibleCount} ${state.kind === 'news' ? 'local updates' : 'events'} · Lee County time`;
        document.dispatchEvent(new Event('leescoop:filtered'));
        updateCounts();
        updateDateCounts();
        clearAll.hidden = !(state.category || state.kind !== 'event' || state.dateWindow || state.query.trim());
        emptyState.hidden = visibleCount > 0;
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const filterButton = target.closest('[data-filter-category]');
        if (filterButton instanceof HTMLElement) {
          event.preventDefault();
          const category = filterButton.getAttribute('data-filter-category') || '';
          state.category = state.category === category ? '' : category;
          applyFilters();
          return;
        }
        const kindButton = target.closest('[data-filter-kind]');
        if (kindButton instanceof HTMLElement) {
          event.preventDefault();
          const kind = kindButton.getAttribute('data-filter-kind') || '';
          state.kind = kind;
          if (state.kind === 'news') state.dateWindow = '';
          applyFilters();
          return;
        }
        const dateButton = target.closest('[data-filter-date-window]');
        if (dateButton instanceof HTMLElement) {
          event.preventDefault();
          const dateWindow = dateButton.getAttribute('data-filter-date-window') || '';
          state.dateWindow = state.dateWindow === dateWindow ? '' : dateWindow;
          if (state.dateWindow) state.kind = 'event';
          applyFilters();
          return;
        }
        if (target.closest('#filter-clear-all') === clearAll) {
          state.category = '';
          state.kind = 'event';
          state.dateWindow = '';
          state.query = '';
          searchInput.value = '';
          applyFilters();
          searchInput.focus();
        }
      });

      searchInput.addEventListener('input', () => {
        state.query = searchInput.value;
        applyFilters();
      });

      searchForm.addEventListener('submit', (event) => {
        event.preventDefault();
        state.query = searchInput.value;
        applyFilters();
      });

      applyFilters();
      // Keep date counts and expiry accurate for tabs left open across midnight.
      window.setInterval(applyFilters, 60_000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) applyFilters(); });
    })();
  </script>

<script>
import "@/lib/discoveryActions";
</script>
</BaseLayout>
