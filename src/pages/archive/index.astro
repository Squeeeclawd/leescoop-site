---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { visibleArticles } from '@/lib/content';

const articles = visibleArticles(await getCollection('articles'));
---
<BaseLayout title="Archive | LeeScoop">
  <Header />
  <main class="wrap page-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Archive</p>
        <h1>All LeeScoop updates</h1>
      </div>
    </div>
    {articles.length > 0 ? (
      <div class="card-grid three">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    ) : (
      <div class="panel-glow home-empty-state">No updates have been published yet.</div>
    )}
  </main>
  <Footer />
</BaseLayout>
