---
import SubpageLayout from '@/layouts/SubpageLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---
<SubpageLayout title="About | LeeScoop" description="About LeeScoop, a simple local guide to what’s happening around Lee County.">
  <Header />
  <main class="wrap page-shell">
    <div class="section-heading">
      <div>
        <h1>About LeeScoop</h1>
        <p class="page-description">Things to do and local news from across Lee County, Florida.</p>
      </div>
    </div>

    <section class="content-sidebar-grid homepage-section">
      <article class="panel-glow">
        <h2>How we pick events</h2>
        <p>A neighborhood walk can be as useful as an arena show. We look for outings with a local connection and enough published detail to help you decide whether to go.</p>
        <p>Check the linked source before heading out: hours, prices, and availability can change.</p>
        <a href="/today/">See what’s on today →</a>
      </article>
      <article class="panel-glow">
        <h2>Submitting an event</h2>
        <p>Organizers can submit a Lee County event for a $50 feature review. That’s separate from the events our editors find.</p>
        <a href="/feature-event/">See submission details →</a>
      </article>
    </section>
  </main>
  <Footer />
</SubpageLayout>
