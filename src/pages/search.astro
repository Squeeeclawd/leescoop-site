---
import SubpageLayout from '@/layouts/SubpageLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---
<SubpageLayout title="Search | LeeScoop">
  <Header />
  <main class="wrap page-shell">
    <div class="section-heading">
      <div>
        <h1>Search LeeScoop</h1>
        <p class="page-description">Search local news and event listings, including past events.</p>
      </div>
    </div>
    <div id="search"></div>
    <noscript><p>Text search needs JavaScript. You can still browse the listings below.</p></noscript>
    <nav class="search-routes" aria-label="Browse without a search">
      <a href="/today/">Today’s events →</a>
      <a href="/map/">Explore the area map →</a>
      <a href="/archive/">Browse the archive →</a>
    </nav>
  </main>
  <Footer />

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (!window.PagefindUI) {
        document.getElementById('search').textContent = 'Search couldn’t load. Use a browse link below or reload to try again.';
        return;
      }
      const search = new window.PagefindUI({
        element: '#search',
        showSubResults: false,
        showImages: false,
        excerptLength: 20,
        openFilters: ['Type'],
        showEmptyFilters: true,
        autofocus: true,
        translations: {
          placeholder: 'Search by event, venue, city, or topic',
          zero_results: 'No matches for “[SEARCH_TERM]”. Try a city or venue name, or clear a filter.'
        }
      });
      const query = new URLSearchParams(window.location.search).get('q');
      if (query) search.triggerSearch(query);
    });
  </script>
</SubpageLayout>
<style>
  .search-routes { display: flex; flex-wrap: wrap; gap: .3rem 1.4rem; margin-top: 1.5rem; border-top: 1px solid #bdceca; padding-top: .6rem; }
  .search-routes a { display: inline-flex; align-items: center; min-height: 44px; color: #07506f; text-underline-offset: .2em; }
  .search-routes a:hover { text-decoration: underline; }
</style>
