---
import SubpageLayout from '@/layouts/SubpageLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---
<SubpageLayout title="Search | LeeScoop">
  <Header />
  <main class="wrap page-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Search</p>
        <h1>Search LeeScoop</h1>
        <p class="page-description">Find your next local outing, a favorite venue, or a useful Lee County update.</p>
      </div>
    </div>
    <div id="search"></div>
  </main>
  <Footer />

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q') ?? undefined;
      new window.PagefindUI({ element: '#search', showSubResults: true, showImages: false, excerptLength: 20, autofocus: true });
      if (q) {
        const input = document.querySelector('#search input');
        if (input) {
          input.value = q;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    });
  </script>
</SubpageLayout>
