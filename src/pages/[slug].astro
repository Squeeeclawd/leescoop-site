---
import { getCollection } from 'astro:content';
import ArticlePage from '@/layouts/ArticlePage.astro';
import { isPublished } from '@/lib/content';

export async function getStaticPaths() {
  const reservedSlugs = new Set(['archive', 'articles', 'category', 'search', 'tag', 'about']);
  const articles = await getCollection('articles');
  return articles
    .filter(isPublished)
    .filter((article) => !reservedSlugs.has(article.slug))
    .map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
---
<ArticlePage article={article} />
